#!/usr/bin/env bash
# lui — build and run .lui files.
#
#   ./lui build app.lui          compile to app.lui.lua
#   ./lui run app.lui            compile, then open the window
#   ./lui watch app.lui          run, and restart the window on every save
#
# Build the tools first: make (see Makefile).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cmd="${1:-}"; file="${2:-}"
[[ -n "$file" && -f "$file" ]] || { echo "usage: lui {build|run|watch} file.lui" >&2; exit 2; }

build() { "$here/bin/luic" "$file"; }
# Every plugins/*.lua beside the .lui file is loaded before the app.
plugins=("$(dirname "$file")"/plugins/*.lua)
[[ -e "${plugins[0]}" ]] || plugins=()
hostcmd=("$here/bin/lui_host" "$file.lua" "$here/src/lui.lua" "${plugins[@]}")

case "$cmd" in
  build) build ;;
  run)   build && "${hostcmd[@]}" ;;
  watch)
    stamp() { stat -c %Y "$file" "$here/src/lui.lua" "$here/bin/luic" 2>/dev/null | tr '\n' ' '; }
    last=""
    host_pid=""
    while true; do
      now="$(stamp)"
      if [[ "$now" != "$last" ]]; then
        last="$now"
        [[ -n "$host_pid" ]] && kill "$host_pid" 2>/dev/null && wait "$host_pid" 2>/dev/null || true
        if build; then
          "${hostcmd[@]}" &
          host_pid=$!
        else
          echo "lui: build failed, fix the error and save again" >&2
        fi
      fi
      sleep 0.4
    done ;;
  *) echo "usage: lui {build|run|watch} file.lui" >&2; exit 2 ;;
esac
