<lui>
<!-- a row of two buttons -->
let count = 0
let row = <row gap=8 align="center" pad=12>
    let label = <label size=20 color="#222">
        "Count: {count}"
    </label>
    <button radius=6 bg={color}>
        "Add"
        <on click>
            let n = 1
            count = count + n
        </on>
    </button>
    <button />
</row>
</lui>
