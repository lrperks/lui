import lui
import raylib

void main()
    let root = lui::node("column")
    let row = lui::node("row")
    let counter = lui::node("label")
    lui::set(counter, "text", "Clicks: 0")
    let btn = lui::node("button")
    lui::set(btn, "text", "Click me")
    btn.hid = 0
    lui::add(row, btn)
    lui::add(row, counter)
    lui::add(root, row)
    lui::open("Lui", 480, 200)
    while lui::frame(root) == 1 do
        let e = lui::poll()
        while e >= 0 do
            if e == 0 * 8 + EV_CLICK then
                btn.text = "Clicked!"
            e = lui::poll()
    lui::close()
