module lui

// Lui runtime — a retained-mode widget tree drawn with raylib.
//
// `luic` (the Lui compiler, itself written in Komodo) turns a `.lui` file
// into plain Komodo that builds a tree of `Node`s with the calls below,
// then drives `open` / `frame` / `poll` / `close` in a loop.  Event
// handlers become ordinary Komodo functions picked by `lui_dispatch`.
//
// Colours are 0xRRGGBB ints (-1 = none); build them with `lui::color`.

import raylib
import string

struct Node
    uid: int = 0
    hid: int = -1            // handler id (assigned by luic); -1 = no handlers
    tag: string = "box"
    text: string = ""
    kids: [Node] = []have you 
    bg: int = -1
    fg: int = 1118481        // #111111
    pad: int = 0
    gap: int = 8
    width: int = 0           // 0 = fit content
    height: int = 0
    size: int = 18
    weight: int = 0
    radius: int = 0
    align: int = 0           // cross axis: 0 start, 1 center, 2 stretch
    x: int = 0
    y: int = 0
    w: int = 0
    h: int = 0
    hover: int = 0
    down: int = 0

// ── event codes handed to `lui_dispatch`:  hid * 8 + kind ───────────
let EV_CLICK be 0
let EV_HOVER be 1
let EV_LEAVE be 2
let EV_PRESS be 3
let EV_RELEASE be 4

let lui_all: [Node] = []
let lui_queue: [int] = []
let lui_qhead = 0
let lui_hot = -1             // uid under the mouse
let lui_active = -1          // uid pressed and not yet released
let lui_bg = 15987699        // #f3f4f6

// ── colours ─────────────────────────────────────────────────────────
fn hexval(c: string): int
    return string.index_of("0123456789abcdef", c)

fn color(s: string): int
    let t = string.to_lower(s)
    if t == "white" then
        return 16777215
    if t == "black" then
        return 0
    if t == "red" then
        return 15680580
    if t == "green" then
        return 2278750
    if t == "blue" then
        return 3900150
    if t == "gray" then
        return 6905260
    if t == "none" then
        return -1
    if string.starts_with(t, "#") == 0 then
        return -1
    if #t == 4 then
        let r = hexval(string(t[1]))
        let g = hexval(string(t[2]))
        let b = hexval(string(t[3]))
        return (r * 17) * 65536 + (g * 17) * 256 + b * 17
    if #t == 7 then
        let v = 0
        for i = 1 until 7
            v = v * 16 + hexval(string(t[i]))
        return v
    return -1

fn clamp255(v: int): int
    if v < 0 then
        return 0
    if v > 255 then
        return 255
    return v

fn shade(c: int, d: int): int
    let r = clamp255(((c >> 16) & 255) + d)
    let g = clamp255(((c >> 8) & 255) + d)
    let b = clamp255((c & 255) + d)
    return r * 65536 + g * 256 + b

// ── building the tree ───────────────────────────────────────────────
// `button` and `label` text lives in `.text`; assign it from handlers
// (`counter.text = "..."`) and the next frame shows it.
mut fn node(tag: string): Node
    let n = new Node()
    n.tag = tag
    n.uid = #lui_all
    lui_all += [n]
    if tag == "button" then
        n.bg = color("#3b82f6")
        n.fg = 16777215
        n.pad = 10
        n.radius = 6
        n.weight = 1
    if tag == "label" then
        n.size = 18
    if tag == "row" then
        n.gap = 8
    return n

void add(parent: Node, child: Node)
    parent.kids += [child]

// Attribute setters used by luic: strings (`bg="#fff"`) and ints (`pad=12`).
void set(n: Node, key: string, v: string)
    if key == "text" then
        n.text = v
    else if key == "bg" then
        n.bg = color(v)
    else if key == "color" then
        n.fg = color(v)
    else if key == "align" then
        n.align = v == "center" and 1 or (v == "stretch" and 2 or 0)
    else if key == "weight" then
        n.weight = v == "bold" and 1 or 0
    else
        throw "lui: unknown string attribute '" + key + "' on <" + n.tag + ">"

void seti(n: Node, key: string, v: int)
    if key == "pad" then
        n.pad = v
    else if key == "gap" then
        n.gap = v
    else if key == "width" then
        n.width = v
    else if key == "height" then
        n.height = v
    else if key == "size" then
        n.size = v
    else if key == "radius" then
        n.radius = v
    else
        throw "lui: unknown number attribute '" + key + "' on <" + n.tag + ">"

// ── layout ──────────────────────────────────────────────────────────
void measure(n: Node)
    let cw = 0
    let ch = 0
    for k in n.kids
        measure(k)
    if n.tag == "label" or n.tag == "button" then
        cw = raylib::rl_measure(n.text, n.size, n.weight)
        ch = n.size + 4
    else if n.tag == "row" then
        for k in n.kids
            cw += k.w
            if k.h > ch then
                ch = k.h
        if #n.kids > 1 then
            cw += n.gap * (#n.kids - 1)
    else
        for k in n.kids
            ch += k.h
            if k.w > cw then
                cw = k.w
        if #n.kids > 1 then
            ch += n.gap * (#n.kids - 1)
    n.w = cw + n.pad * 2
    n.h = ch + n.pad * 2
    if n.width > 0 then
        n.w = n.width
    if n.height > 0 then
        n.h = n.height

void place(n: Node, x: int, y: int)
    n.x = x
    n.y = y
    let cx = x + n.pad
    let cy = y + n.pad
    let innerW = n.w - n.pad * 2
    let innerH = n.h - n.pad * 2
    for k in n.kids
        if n.tag == "row" then
            if n.align == 2 then
                k.h = innerH
            let dy = n.align == 1 and (innerH - k.h) / 2 or 0
            place(k, cx, cy + dy)
            cx += k.w + n.gap
        else
            if n.align == 2 then
                k.w = innerW
            let dx = n.align == 1 and (innerW - k.w) / 2 or 0
            place(k, cx + dx, cy)
            cy += k.h + n.gap

// ── drawing ─────────────────────────────────────────────────────────
void draw(n: Node)
    if n.bg >= 0 then
        let c = n.bg
        if n.tag == "button" then
            if n.down == 1 then
                c = shade(c, -35)
            else if n.hover == 1 then
                c = shade(c, 22)
        raylib::rl_round(n.x, n.y, n.w, n.h, n.radius, (c >> 16) & 255, (c >> 8) & 255, c & 255, 255)
    if n.text != "" then
        let tw = raylib::rl_measure(n.text, n.size, n.weight)
        let tx = n.x + n.pad
        let ty = n.y + n.pad
        if n.tag == "button" then
            tx = n.x + (n.w - tw) / 2
            ty = n.y + (n.h - n.size) / 2 - 2
        let f = n.fg
        raylib::rl_text(n.text, tx, ty, n.size, n.weight, (f >> 16) & 255, (f >> 8) & 255, f & 255, 255)
    for k in n.kids
        draw(k)

// ── input ───────────────────────────────────────────────────────────
// Deepest node under (mx, my); -1 if none.  Later siblings win.
fn hit(n: Node, mx: int, my: int): int
    if mx < n.x or my < n.y or mx >= n.x + n.w or my >= n.y + n.h then
        return -1
    let found = n.uid
    for k in n.kids
        let h = hit(k, mx, my)
        if h >= 0 then
            found = h
    return found

void emit(n: Node, kind: int)
    if n.hid >= 0 then
        lui_queue += [n.hid * 8 + kind]

void update(root: Node)
    let mx = raylib::GetMouseX()
    let my = raylib::GetMouseY()
    let now = hit(root, mx, my)
    if now != lui_hot then
        if lui_hot >= 0 then
            let old = lui_all[lui_hot]
            old.hover = 0
            emit(old, EV_LEAVE)
        lui_hot = now
        if now >= 0 then
            let nn = lui_all[now]
            nn.hover = 1
            emit(nn, EV_HOVER)
    if lui_hot >= 0 and raylib::rl_mouse_pressed(0) == 1 then
        let pn = lui_all[lui_hot]
        pn.down = 1
        lui_active = lui_hot
        emit(pn, EV_PRESS)
    if lui_active >= 0 and raylib::rl_mouse_released(0) == 1 then
        let an = lui_all[lui_active]
        an.down = 0
        emit(an, EV_RELEASE)
        if lui_active == lui_hot then
            emit(an, EV_CLICK)
        lui_active = -1

// Next queued event code (hid * 8 + kind), or -1 when drained.
mut fn poll(): int
    if lui_qhead >= #lui_queue then
        lui_queue = []
        lui_qhead = 0
        return -1
    let e = lui_queue[lui_qhead]
    lui_qhead += 1
    return e

// ── window ──────────────────────────────────────────────────────────
void open(title: string, w: int, h: int)
    raylib::SetConfigFlags(raylib::FLAG_MSAA_4X_HINT)
    raylib::InitWindow(w, h, title)
    raylib::SetTargetFPS(60)
    raylib::rl_ui_fonts("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf")

// One frame: input -> layout -> paint.  Returns 0 once the window closes.
mut fn frame(root: Node): int
    if raylib::rl_should_close() == 1 then
        return 0
    measure(root)
    place(root, 0, 0)
    update(root)
    raylib::BeginDrawing()
    raylib::ClearBackground(copy(raylib::rl_rgb((lui_bg >> 16) & 255, (lui_bg >> 8) & 255, lui_bg & 255)))
    draw(root)
    raylib::EndDrawing()
    return 1

void close()
    raylib::CloseWindow()
