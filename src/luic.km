// luic — compiles a .lui file (custom XML markup with Lua, see LUI.md)
// into a compact Lua chunk that builds the widget tree through the `lui`
// runtime.  Output is minified: no indentation or blank lines, generated
// names are short and scrambled, and the runtime is bound to one letter.
//
//   komodo -c -o luic luic.km
//   ./luic counter.lui                writes counter.lui.lua
//   ./luic counter.lui out.lua        writes out.lua

import file

let src = ""
let pos = 0
let line = 1
let counter = 0
let out: [string] = []
let GLYPHS = "qwertyuiopasdfghjklzxcvbnmQWERTYUIOPASDFGHJKLZXCVBNM"

// ── cursor ──────────────────────────────────────────────────────────

fn fail(msg: string): string
    return "luic: line " + string(line) + ": " + msg

fn look(k: int): string
    if pos + k >= #src then
        return ""
    return string(src[pos + k])

void step()
    if pos < #src then
        if src[pos] == '\n' then
            line += 1
        pos += 1

fn at(s: string): bool
    for i = 0 until #s
        if look(i) != string(s[i]) then
            return false
    return true

void skipWs()
    while look(0) != "" and (look(0) in " \t\r\n") do
        step()

void expect(c: string)
    skipWs()
    if look(0) != c then
        throw fail("expected '" + c + "' but found '" + look(0) + "'")
    step()

void skipComment()
    while not at("-->") do
        if pos >= #src then
            throw fail("unterminated comment")
        step()
    pos += 3

void skipToGt()
    while look(0) != "" and look(0) != ">" do
        step()
    expect(">")

fn isNameChar(c: string): bool
    return c != "" and (c in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_")

mut fn readName(): string
    let s = ""
    while isNameChar(look(0)) do
        s = s + look(0)
        step()
    return s

mut fn readNumber(): string
    let s = ""
    while look(0) != "" and (look(0) in "0123456789.-") do
        s = s + look(0)
        step()
    if s == "" then
        throw fail("expected a number")
    return s

// `"..."` — returns the raw text between the quotes.
mut fn readQuoted(): string
    step()
    let s = ""
    while look(0) != "\"" do
        if look(0) == "" then
            throw fail("unterminated string")
        s = s + look(0)
        step()
    step()
    return s

// `{...}` — returns the Lua expression between the braces.
mut fn readBraced(): string
    step()
    let depth = 1
    let s = ""
    while depth > 0 do
        if look(0) == "" then
            throw fail("unterminated '{'")
        if look(0) == "{" then
            depth += 1
        if look(0) == "}" then
            depth -= 1
        if depth > 0 then
            s = s + look(0)
        step()
    return s

// ── output ──────────────────────────────────────────────────────────

void emit(s: string)
    out += [s]

// Scrambled short name for a generated local: _ followed by letters.
mut fn fresh(): string
    counter += 1
    let n = counter
    let s = "_"
    while n > 0 do
        s = s + string(GLYPHS[n % 52])
        n = (n - n % 52) / 52
    return s

// Lua string literal for s.
fn luaStr(s: string): string
    let r = "\""
    for i = 0 until #s
        let c = string(s[i])
        if c == "\\" then
            r = r + "\\\\"
        else if c == "\"" then
            r = r + "\\\""
        else if c == "\n" then
            r = r + "\\n"
        else
            r = r + c
    return r + "\""

// Text child: plain text sets .text once; `{expr}` pieces make the text
// a live binding that the runtime re-evaluates every frame.
void emitText(node: string, raw: string)
    let parts: [string] = []
    let lit = ""
    let dyn = false
    let i = 0
    while i < #raw do
        let c = string(raw[i])
        if c == "{" then
            if lit != "" then
                parts += [luaStr(lit)]
                lit = ""
            let j = i + 1
            let e = ""
            while j < #raw and string(raw[j]) != "}" do
                e = e + string(raw[j])
                j += 1
            parts += ["tostring(" + e + ")"]
            dyn = true
            i = j + 1
        else
            lit = lit + c
            i += 1
    if lit != "" then
        parts += [luaStr(lit)]
    if #parts == 0 then
        parts += ["\"\""]
    if dyn then
        emit("L.bindtext(" + node + ",function()return " + join(parts, "..") + " end)")
    else
        emit(node + ".text=" + join(parts, ".."))

// ── grammar ─────────────────────────────────────────────────────────

// Attributes up to '>' or '/>'.  Returns true for a self-closing tag.
mut fn parseAttrs(node: string): bool
    let selfClosing = false
    let done = false
    while not done do
        skipWs()
        if at("/>") then
            step()
            step()
            selfClosing = true
            done = true
        else if look(0) == ">" then
            step()
            done = true
        else
            parseAttr(node)
    return selfClosing

mut fn parseAttr(node: string)
    let key = readName()
    if key == "" then
        throw fail("bad attribute in <" + node + ">")
    skipWs()
    if look(0) == "=" then
        step()
        skipWs()
        if look(0) == "\"" then
            emit(node + "." + key + "=" + luaStr(readQuoted()))
        else if look(0) == "{" then
            emit("L.bind(" + node + "," + luaStr(key) + ",function()return " + readBraced() + " end)")
        else
            emit(node + "." + key + "=" + readNumber())
    else
        emit(node + "." + key + "=true")

// `<on EVENT> lua </on>` inside an element.  The body is minified: indentation
// and blank lines are dropped, and `let` becomes `local`.
void parseOn(node: string)
    step()
    readName()
    skipWs()
    let ev = readName()
    expect(">")
    let body = ""
    let lineStart = true
    let newline = false
    while not at("</on>") do
        if pos >= #src then
            throw fail("unterminated <on " + ev + ">")
        if lineStart and (look(0) == " " or look(0) == "\t" or look(0) == "\r") then
            step()
        else if look(0) == "\n" then
            newline = not lineStart
            lineStart = true
            step()
        else
            if newline then
                body = body + "\n"
                newline = false
            if lineStart and at("let ") then
                body = body + "local "
                pos += 4
            else
                body = body + look(0)
                step()
            lineStart = false
    pos += 5
    emit("L.on(" + node + "," + luaStr(ev) + ",function(self,g,dt)" + body + "\nend)")

// `<tag ...> children </tag>`, starting at '<'.  parent == "" for a root.
void parseElement(binding: string, parent: string)
    step()
    let tag = readName()
    if tag == "" then
        throw fail("expected a tag name")
    let node = binding
    if node == "" then
        node = fresh()
    emit("local " + node + "=L.node(" + luaStr(tag) + ")")
    if parent == "" then
        emit("L.root(" + node + ")")
    else
        emit("L.add(" + parent + "," + node + ")")
    if not parseAttrs(node) then
        parseChildren(node, tag)

// `let NAME = <tag> ... </tag>`, starting at 'let'.
void parseLet(parent: string)
    step()
    step()
    step()
    step()
    skipWs()
    let name = readName()
    expect("=")
    skipWs()
    if look(0) != "<" then
        throw fail("expected <tag> after 'let " + name + " ='")
    parseElement(name, parent)

// True when the text at pos is `let NAME = <`.  Leaves pos and line alone.
mut fn letElementAhead(): bool
    if not at("let ") then
        return false
    let p = pos
    let l = line
    pos += 4
    skipWs()
    let n = readName()
    skipWs()
    let res = false
    if n != "" and look(0) == "=" then
        step()
        skipWs()
        res = look(0) == "<"
    pos = p
    line = l
    return res

void parseChildren(node: string, tag: string)
    while true do
        skipWs()
        if pos >= #src then
            throw fail("unterminated <" + tag + ">")
        if at("</") then
            step()
            step()
            let close = readName()
            expect(">")
            if close != tag then
                throw fail("expected </" + tag + "> but found </" + close + ">")
            return
        if at("<!--") then
            skipComment()
        else if at("<on ") then
            parseOn(node)
        else if at("<") then
            parseElement("", node)
        else if look(0) == "\"" then
            emitText(node, readQuoted())
        else if letElementAhead() then
            parseLet(node)
        else
            throw fail("unexpected '" + look(0) + "' in <" + tag + ">")

// A top-level Lua line, from its first non-blank column to the end of the
// line.  With fixLet, a leading `let` becomes Lua's `local`.
void copyLine(fixLet: bool)
    let text = ""
    if fixLet then
        text = "local "
        pos += 4
    while pos < #src and src[pos] != '\n' do
        text = text + string(src[pos])
        pos += 1
    emit(text)

void parseTop()
    while true do
        skipWs()
        if pos >= #src then
            return
        if at("<lui") then
            pos += 4
            emit("L.cfg={}")
            parseAttrs("L.cfg")
        else if at("</lui") then
            skipToGt()
        else if at("<!--") then
            skipComment()
        else if letElementAhead() then
            parseLet("")
        else if at("<") then
            parseElement("", "")
        else
            copyLine(at("let "))

void main(args)
    if #args < 2 then
        throw "usage: luic <file.lui> [out.lua]"
    let input = args[1]
    let output = input + ".lua"
    if #args > 2 then
        output = args[2]
    src = file::read_all(input)
    emit("local L=require\"lui\"")
    parseTop()
    file::write_all(output, join(out, "\n") + "\n")
    print("wrote", output)
